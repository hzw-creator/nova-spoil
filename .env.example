# Copy to .env.local (never commit .env.local). Owner: Agent B
# Get a key at https://openrouter.ai/keys — without it, /api/brain/* returns mock data.
OPENROUTER_API_KEY=
# Any vision-capable model id from https://openrouter.ai/models (check it exists before the demo)
VISION_MODEL=google/gemini-2.5-flash
TEXT_MODEL=google/gemini-2.5-flash
